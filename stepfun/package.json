{
  "name": "seekdb-stepfun-kb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-side embedding with seekdb hybrid retrieval: a mini knowledge base for the StepFun ecosystem task",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "sh scripts/with-seekdb-lib.sh server/index.mjs",
    "dev": "concurrently -k -n web,server \"npm:dev:web\" \"npm:dev:server\"",
    "build": "vite build",
    "start": "npm run build && sh scripts/with-seekdb-lib.sh server/index.mjs",
    "benchmark": "npm run bench:matrix",
    "test": "node --test bench/query-timing.test.mjs",
    "bench:matrix": "node bench/matrix.mjs",
    "bench:e2e": "node bench/e2e.mjs",
    "bench:embedding": "node bench/bench.mjs",
    "bench:sweep": "node bench/sweep.mjs",
    "typecheck": "tsc --noEmit",
    "models": "sh scripts/fetch-models.sh",
    "note:pdf": "node scripts/render-tech-note.mjs",
    "setup": "sh scripts/ensure-bindings.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@seekdb/js-bindings": "1.4.0",
    "express": "^4.21.2",
    "seekdb": "1.4.0",
    "vite": "^6.0.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "concurrently": "^9.1.2",
    "puppeteer-core": "^24.10.2",
    "typescript": "^5.7.3"
  }
}
