# Copy to .env and fill in real values. .env is git-ignored.
# MiniMax (OpenAI compatible chat completions)
MINIMAX_API_KEY=sk-your-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# PowerContext server used for task state
POWERCONTEXT_URL=http://127.0.0.1:8000

# Engineering-material database
# embedded: pylibseekdb opens a local seekdb instance under SDDCTX_DB_DIR
SDDCTX_DB_MODE=embedded
SDDCTX_DB_DIR=.seekdb
# server: reuse an OceanBase / MySQL endpoint instead
# SDDCTX_DB_MODE=server
# SDDCTX_DSN=mysql://root@127.0.0.1:2881/sdd_context

SDDCTX_PROJECT_ID=ordermesh
