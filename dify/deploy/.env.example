# Run scripts/bootstrap.py to generate real local service secrets.
PAWNSHOP_API_KEY=replace-with-a-random-local-secret
POWERCONTEXT_TOKEN=replace-with-a-different-random-local-secret
POWERCONTEXT_SOURCE=D:/DifyPawnshop/powercontext-source
POWERCONTEXT_VERSION=1.4.0
PAWNSHOP_DATA=D:/DifyPawnshop/data
PAWNSHOP_PORT=18081
POWERCONTEXT_PORT=18082
# 自定义前端（浏览器 → 后端 BFF → Dify）使用。应用 API 密钥在 Dify 应用的
# 「访问 API」页生成，只写在本机 .env，不要提交。留空时前端仍可打开，
# 但发送消息会提示尚未接上模型。
DIFY_API_URL=http://api:5001/v1
DIFY_APP_API_KEY=
# 给当票 Cookie 签名；bootstrap.py 会自动生成。
PAWNSHOP_SESSION_SECRET=replace-with-a-random-local-secret
